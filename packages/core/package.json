{
  "name": "@platonic-dice/core",
  "version": "4.0.1",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Expression-first core runtime for tabletop dice rolls.",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./entities": {
      "import": "./dist/entities/index.js",
      "require": "./dist/entities/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "dice",
    "TTRPG",
    "random",
    "game",
    "d20",
    "dnd",
    "core"
  ],
  "author": "Stephen James Saunders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sjs2k20/platonic-dice.git"
  },
  "bugs": {
    "url": "https://github.com/sjs2k20/platonic-dice.git/issues"
  },
  "homepage": "https://github.com/sjs2k20/platonic-dice.git#readme",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp -R src/* dist/ && find dist -name \"*.d.ts\" -delete",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --config ./vitest.config.mjs",
    "test:watch": "vitest --config ./vitest.config.mjs",
    "test:coverage": "vitest run --coverage --config ./vitest.config.mjs"
  },
  "devDependencies": {}
}
