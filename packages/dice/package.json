{
  "name": "@platonic-dice/dice",
  "version": "2.4.0",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Persistent dice objects with roll history and TypeScript support.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "dice",
    "TTRPG",
    "random",
    "game",
    "d20",
    "dnd"
  ],
  "author": "Stephen James Saunders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sjs2k20/platonic-dice.git"
  },
  "bugs": {
    "url": "https://github.com/sjs2k20/platonic-dice.git/issues"
  },
  "homepage": "https://github.com/sjs2k20/platonic-dice.git#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@platonic-dice/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@platonic-dice/types-core": "workspace:*",
    "tsc-alias": "^1.9.1",
    "vitest": "^4.1.10"
  }
}
